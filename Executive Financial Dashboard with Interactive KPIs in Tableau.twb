      </column>
      <column caption='This Year' datatype='integer' name='[Calculation_2910739095527431]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([Date]) = YEAR(TODAY()) THEN &#13;&#10;&#13;&#10;CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;Revenue&quot; THEN [Revenue]&#13;&#10;    WHEN &quot;COGS&quot; THEN [COGS]&#13;&#10;    WHEN &quot;Gross Profit&quot; THEN [Gross Profit]&#13;&#10;    WHEN &quot;Operating Expenses&quot; THEN [Operating Expenses]&#13;&#10;    WHEN &quot;Operating Income&quot; THEN [Operating Income]&#13;&#10;    WHEN &quot;Interest Expense&quot; THEN [Interest Expense]&#13;&#10;    WHEN &quot;Pre-Tax Income&quot; THEN [Pre-Tax Income]&#13;&#10;    WHEN &quot;Income Tax&quot; THEN [Income Tax]&#13;&#10;    WHEN &quot;Net Income&quot; THEN [Net Income]&#13;&#10;END&#13;&#10;END' />
      </column>
      <column caption='Min Value' datatype='integer' name='[Calculation_2910739391934473]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF &#13;&#10;{FIXED : MIN({FIXED YEAR([Date]), MONTH([Date]): SUM(IF [Division] IN [Division Set] AND [Region] IN [Region Set] THEN [This Year (copy)_2910739096358920] END )})}&#13;&#10;&lt; {FIXED : MIN({FIXED YEAR([Date]), MONTH([Date]): SUM(IF [Division] IN [Division Set] AND [Region] IN [Region Set] THEN [Calculation_2910739095527431] END )})}&#13;&#10;THEN {FIXED : MIN({FIXED YEAR([Date]), MONTH([Date]): SUM(IF [Division] IN [Division Set] AND [Region] IN [Region Set] THEN [This Year (copy)_2910739096358920] END )})}&#13;&#10;ELSE {FIXED : MIN({FIXED YEAR([Date]), MONTH([Date]): SUM(IF [Division] IN [Division Set] AND [Region] IN [Region Set] THEN [Calculation_2910739095527431] END )})}&#13;&#10;END' />
      </column>
      <column datatype='string' name='[Division]' role='dimension' type='nominal' />
      <column caption='Gross Margin Delta' datatype='real' name='[Gross Margin (copy)_2910738874306564]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF YEAR([Date]) = YEAR(TODAY())THEN[Gross Profit] END)&#13;&#10;/SUM(IF YEAR([Date]) = YEAR(TODAY()) THEN[Revenue] END))&#13;&#10;- (SUM(IF YEAR([Date]) = YEAR(TODAY())-1 THEN[Gross Profit] END)&#13;&#10;/SUM(IF YEAR([Date]) = YEAR(TODAY())-1 THEN[Revenue] END))' />
      </column>
      <column caption='Max  Value ' datatype='integer' name='[Min Value (copy)_2910739398254602]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF &#13;&#10;{FIXED : MAX({FIXED YEAR([Date]), MONTH([Date]): SUM(IF [Division] IN [Division Set] AND [Region] IN [Region Set] THEN [This Year (copy)_2910739096358920] END )})}&#13;&#10;&gt; {FIXED : MAX({FIXED YEAR([Date]), MONTH([Date]): SUM(IF [Division] IN [Division Set] AND [Region] IN [Region Set] THEN [Calculation_2910739095527431] END )})}&#13;&#10;THEN {FIXED : MAX({FIXED YEAR([Date]), MONTH([Date]): SUM(IF [Division] IN [Division Set] AND [Region] IN [Region Set] THEN [This Year (copy)_2910739096358920] END )})}&#13;&#10;ELSE {FIXED : MAX({FIXED YEAR([Date]), MONTH([Date]): SUM(IF [Division] IN [Division Set] AND [Region] IN [Region Set] THEN [Calculation_2910739095527431] END )})}&#13;&#10;END' />
      </column>
      <column caption='Operating Margin Delta' datatype='real' name='[Operating Margin (copy)_2910738875502597]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF YEAR([Date]) = YEAR(TODAY()) THEN[Operating Income] END)&#13;&#10;/SUM(IF YEAR([Date])= YEAR(TODAY()) THEN[Revenue] END)&#13;&#10;- SUM(IF YEAR([Date]) = YEAR(TODAY())-1 THEN[Operating Income] END)&#13;&#10;/SUM(IF YEAR([Date])= YEAR(TODAY())-1 THEN[Revenue] END)' />
      </column>
